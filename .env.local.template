# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the two [YOUR-PASSWORD] placeholders
# and SESSION_SECRET. .env.local is gitignored — nothing here reaches the repo.
#
#   cp .env.local.template .env.local
#
# Get both connection strings from the Supabase dashboard:
#   Connect  →  Direct  →  Connection string
# ─────────────────────────────────────────────────────────────────────────────

# ── The app's connection: TRANSACTION POOLER, port 6543 ──────────────────────
# Labelled "Transaction pooler" in the Connect dialog. Note the username is
# postgres.PROJECT_REF, not plain postgres. Prepared statements are turned off
# automatically for this mode.
DATABASE_URL=postgresql://postgres.jusmuwfvvxlvkwlkntbc:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres

# ── Migrations: SESSION POOLER, port 5432 ────────────────────────────────────
# Labelled "Session pooler". Migrations need a session that stays on one
# backend, which transaction pooling cannot give. This also works over IPv4,
# unlike the "Direct connection" host, which is IPv6-only on the free plan.
DIRECT_DATABASE_URL=postgresql://postgres.jusmuwfvvxlvkwlkntbc:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres

# ── Session cookie signing key ───────────────────────────────────────────────
# Generate with:  openssl rand -base64 32
# The app refuses to start in production without this.
SESSION_SECRET=

# ── Optional ─────────────────────────────────────────────────────────────────
# DATABASE_POOL_MAX=      # defaults to 1 on serverless, 10 elsewhere
# MIGRATE_ON_START=       # "true" only on a single always-on container
