# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.local for development, or set these in your host's dashboard.
# Nothing here is needed to run locally: with no DATABASE_URL the app starts an
# embedded Postgres under .data/ and works immediately.
# ─────────────────────────────────────────────────────────────────────────────

# Postgres connection string. Setting this switches the app off embedded
# Postgres and onto your database — same schema, same migrations.
#
#   Supabase   postgresql://postgres.PROJECT:PASSWORD@[YOUR-POOLER-HOST].pooler.supabase.com:6543/postgres
#   Neon       postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
#   Railway    postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/railway
#   Local      postgresql://postgres:postgres@localhost:5432/vender?sslmode=disable
#
# Use the POOLED URL for the app (port 6543 on Supabase, "-pooler" on Neon).
# Prepared statements are turned off automatically when a pooler is detected.
DATABASE_URL=

# The DIRECT (non-pooled) URL, used only by `npm run db:migrate`. A transaction
# pooler cannot run the session-level DDL that migrations need.
DIRECT_DATABASE_URL=

# Signs the session cookie. REQUIRED in production — the app refuses to start
# without it. Generate one with:  openssl rand -base64 32
SESSION_SECRET=

# Optional. Connections per app instance. Defaults to 1 on serverless hosts
# (Vercel, Lambda) and 10 elsewhere. Raise only if your database can take it.
DATABASE_POOL_MAX=

# Optional. Set to "true" to run migrations when the app boots instead of at
# deploy time. Convenient on a single always-on container; a bad idea on
# serverless, where many instances would race each other.
MIGRATE_ON_START=

# Optional. Points scripts and tests at a different embedded database so they do
# not fight the dev server for .data/pg.
PGLITE_DIR=
