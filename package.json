{
  "name": "vender",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:reset": "rm -rf .data",
    "smoke": "PGLITE_DIR=.data/smoke NODE_OPTIONS=--conditions=react-server tsx scripts/smoke.ts",
    "test": "tsx --test src/domain/*.test.ts src/lib/*.test.ts",
    "db:migrate": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "db:seed:demo": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/seed.ts",
    "db:ping": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/db-ping.ts",
    "db:setup": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/db-setup.ts",
    "tenancy": "PGLITE_DIR=.data/tenancy NODE_OPTIONS=--conditions=react-server tsx scripts/tenancy.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.7",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.34.0",
    "next": "16.3.2",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
